//@version=5
indicator("3-Line Stepped Trend Ribbon (SuperTrend ATR Ratchet)", overlay=true)

// ==========================================
// 1. THAM SỐ ĐẦU VÀO (INPUT PARAMETERS)
// ==========================================
grp_main  = "Cấu hình 3 Đường Trend Ở Giữa"
tc_period = input.int(14, "Chu kỳ ATR (ATR Period)", minval=1, group=grp_main)
tc_mult   = input.float(3.0, "Hệ số nhân (Multiplier)", minval=0.1, step=0.1, group=grp_main)
tc_dev    = input.float(0.5, "Độ rộng 3 đường (Band Offset)", minval=0.1, step=0.1, group=grp_main)

grp_sub   = "Đường Phụ Bậc Thang (Secondary Ribbon)"
tp_period = input.int(14, "ATR Period Phụ", minval=1, group=grp_sub)
tp_mult   = input.float(1.0, "Multiplier Phụ", minval=0.1, step=0.1, group=grp_sub)

// ==========================================
// 2. THUẬT TOÁN 3 ĐƯỜNG BẬC THANG (ATR RATCHET ENGINE)
// ==========================================
atr_tc = ta.atr(tc_period)
dev_tc = tc_dev * atr_tc

var float tc1 = na
var bool is_uptrend = true

up_bound_tc = low - tc_mult * atr_tc
dn_bound_tc = high + tc_mult * atr_tc

if na(tc1)
    tc1 := up_bound_tc
    is_uptrend := true
else
    if is_uptrend
        tc1 := math.max(tc1, up_bound_tc)
        if close < tc1
            is_uptrend := false
            tc1 := dn_bound_tc
    else
        tc1 := math.min(tc1, dn_bound_tc)
        if close > tc1
            is_uptrend := true
            tc1 := up_bound_tc

// 3 Đường ở giữa (Upper, Center, Lower)
tc2 = tc1 + dev_tc  // Đường trên
tc3 = tc1 - dev_tc  // Đường dưới

// ==========================================
// 3. THUẬT TOÁN ĐƯỜNG PHỤ BẬC THANG
// ==========================================
atr_tp = ta.atr(tp_period)
var float tp1 = na

up_bound_tp = low - tp_mult * atr_tp
dn_bound_tp = high + tp_mult * atr_tp

if na(tp1)
    tp1 := up_bound_tp
else
    if is_uptrend
        tp1 := math.max(tp1, up_bound_tp)
    else
        tp1 := math.min(tp1, dn_bound_tp)

tp2 = tp1[2]

// ==========================================
// 4. MÀU SẮC XANH / ĐỎ KHI ĐỔI TREND
// ==========================================
// Màu Xanh khi Tăng (Uptrend), Màu Đỏ khi Giảm (Downtrend)
color_trend = is_uptrend ? color.green : color.red
color_fill  = is_uptrend ? color.new(color.green, 70) : color.new(color.red, 70)

// ==========================================
// 5. VẼ 3 ĐƯỜNG NẤC THANG Ở GIỮA & FILL DẢI MÀU
// ==========================================
// Đường 1: Đường Trên (Upper Band)
p_tc2 = plot(tc2, "Đường Trên (Upper Line)", color=color_trend, linewidth=2)

// Đường 2: Đường Giữa (Center Line)
p_tc1 = plot(tc1, "Đường Giữa (Center Line)", color=color_trend, linewidth=3)

// Đường 3: Đường Dưới (Lower Band)
p_tc3 = plot(tc3, "Đường Dưới (Lower Line)", color=color_trend, linewidth=2)

// Tô dải màu Xanh / Đỏ nấc thang giữa Đường Trên và Đường Dưới
fill(p_tc2, p_tc3, color=color_fill, title="Dải Bậc Thang Xanh / Đỏ")

// Đường Phụ nấc thang phụ trợ
color_tp = tp1 >= tp2 ? color.lime : color.maroon
plot(tp1, "Đường Phụ 1", color=color_tp, linewidth=2)
plot(tp2, "Đường Phụ 2", color=color.new(color.white, 40), linewidth=1, style=plot.style_circles)

// ==========================================
// 6. TÍN HIỆU GIAO DỊCH BUY / SELL / WARNING
// ==========================================
bull_regime = close > tc1
bear_regime = close < tc1

tp_cross_up       = ta.crossover(tp1, tp2)
tp_cross_dn       = ta.crossunder(tp1, tp2)
tp_bull_expansion = (tp1 > tp1[1]) and (tp1[1] == tp2[1])
tp_bear_expansion = (tp1 < tp1[1]) and (tp1[1] == tp2[1])

sig_buy  = bull_regime and tp1 >= tp2 and tp1 > tc1 and (tp_cross_up or tp_bull_expansion or ta.crossover(close, tc1))
sig_sell = bear_regime and tp1 <= tp2 and tp1 < tc1 and (tp_cross_dn or tp_bear_expansion or ta.crossunder(close, tc1))
sig_warn = (bull_regime and (tp_cross_dn or (close >= tc2 and close < close[1]))) or 
           (bear_regime and (tp_cross_up or (close <= tc3 and close > close[1])))

plotshape(sig_buy, title="Signal BUY", style=shape.labelup, location=location.belowbar, 
          color=color.green, textcolor=color.white, text="BUY", size=size.small)

plotshape(sig_sell, title="Signal SELL", style=shape.labeldown, location=location.abovebar, 
          color=color.red, textcolor=color.white, text="SELL", size=size.small)

plotshape(sig_warn, title="Warning", style=shape.xcross, location=location.abovebar, 
          color=color.orange, size=size.tiny)

alertcondition(sig_buy, title="Alert BUY", message="BUY Signal at {{close}}")
alertcondition(sig_sell, title="Alert SELL", message="SELL Signal at {{close}}")

