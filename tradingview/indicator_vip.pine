//@version=5
indicator("VIP Multi-Trend Indicator (Exact Reconstructed)", overlay=true)

// ==========================================
// 1. INPUT PARAMETERS (EXACT REVERSED VALUES)
// ==========================================
grp_main  = "Trend Chính (Primary Channel)"
tc_period = input.int(14, "ATR Period Chính", minval=1, group=grp_main)
tc_mult   = input.float(3.0, "Multiplier Chính (Exact: 3.0)", minval=0.1, step=0.1, group=grp_main)
tc_dev    = input.float(0.5, "Band Deviation Factor (Exact: 0.5)", minval=0.1, step=0.1, group=grp_main)

grp_sub   = "Trend Phụ (Secondary Ribbon)"
tp_period = input.int(14, "ATR Period Phụ", minval=1, group=grp_sub)
tp_mult   = input.float(1.0, "Multiplier Phụ (Exact: 1.0)", minval=0.1, step=0.1, group=grp_sub)

// ==========================================
// 2. TREND CHÍNH ENGINE (ATR RATCHET TRAILING STOP)
// ==========================================
atr_tc = ta.atr(tc_period)
dev_tc = tc_dev * atr_tc

var float tc1 = na
var bool is_uptrend = true

up_bound_tc = low - tc_mult * atr_tc
dn_bound_tc = high + tc_mult * atr_tc

if na(tc1)
    tc1 := up_bound_tc
    is_uptrend := true
else
    if is_uptrend
        tc1 := math.max(tc1, up_bound_tc)
        if close < tc1
            is_uptrend := false
            tc1 := dn_bound_tc
    else
        tc1 := math.min(tc1, dn_bound_tc)
        if close > tc1
            is_uptrend := true
            tc1 := up_bound_tc

tc2 = tc1 + dev_tc
tc3 = tc1 - dev_tc

// ==========================================
// 3. TREND PHỤ ENGINE (FAST STRUCTURE RIBBON)
// ==========================================
atr_tp = ta.atr(tp_period)

var float tp1 = na

up_bound_tp = low - tp_mult * atr_tp
dn_bound_tp = high + tp_mult * atr_tp

if na(tp1)
    tp1 := up_bound_tp
else
    if is_uptrend
        tp1 := math.max(tp1, up_bound_tp)
    else
        tp1 := math.min(tp1, dn_bound_tp)

// Exact verified: Trend Phụ 2 is Trend Phụ 1 lagged by 2 bars
tp2 = tp1[2]

// ==========================================
// 4. SIGNAL GENERATION LOGIC
// ==========================================
bull_regime = close > tc1
bear_regime = close < tc1

// Cross & Expansion conditions
tp_cross_up       = ta.crossover(tp1, tp2)
tp_cross_dn       = ta.crossunder(tp1, tp2)
tp_bull_expansion = (tp1 > tp1[1]) and (tp1[1] == tp2[1])
tp_bear_expansion = (tp1 < tp1[1]) and (tp1[1] == tp2[1])

// Signal 2 = Strong BUY (Bullish Regime + TP1 >= TP2 + TP1 > TC1)
sig_buy  = bull_regime and tp1 >= tp2 and tp1 > tc1 and (tp_cross_up or tp_bull_expansion or ta.crossover(close, tc1))

// Signal 1 = Strong SELL (Bearish Regime + TP1 <= TP2 + TP1 < TC1)
sig_sell = bear_regime and tp1 <= tp2 and tp1 < tc1 and (tp_cross_dn or tp_bear_expansion or ta.crossunder(close, tc1))

// Signal 4 = Warning / Pullback / Take Profit
sig_warn = (bull_regime and (tp_cross_dn or (close >= tc2 and close < close[1]))) or 
           (bear_regime and (tp_cross_up or (close <= tc3 and close > close[1])))

// ==========================================
// 5. PLOTTING & VISUAL STYLING
// ==========================================
tc_color = is_uptrend ? color.green : color.red

p_tc1 = plot(tc1, "Trend Chính 1 (Center)", color=tc_color, linewidth=2)
p_tc2 = plot(tc2, "Trend Chính 2 (Upper)", color=color.new(tc_color, 40), linewidth=1)
p_tc3 = plot(tc3, "Trend Chính 3 (Lower)", color=color.new(tc_color, 40), linewidth=1)
fill(p_tc2, p_tc3, color=color.new(tc_color, 88), title="Trend Chính Channel")

plot(tp1, "Trend Phụ 1", color=color.yellow, linewidth=2)
plot(tp2, "Trend Phụ 2", color=color.new(color.white, 50), linewidth=1, style=plot.style_circles)

plotshape(sig_buy, title="Signal BUY (2)", style=shape.labelup, location=location.belowbar, 
          color=color.green, textcolor=color.white, text="BUY", size=size.small)

plotshape(sig_sell, title="Signal SELL (1)", style=shape.labeldown, location=location.abovebar, 
          color=color.red, textcolor=color.white, text="SELL", size=size.small)

plotshape(sig_warn, title="Warning / Pullback (4)", style=shape.xcross, location=location.abovebar, 
          color=color.orange, size=size.tiny)

alertcondition(sig_buy, title="Alert BUY Signal", message="VIP Indicator: BUY Signal on {{ticker}} at {{close}}")
alertcondition(sig_sell, title="Alert SELL Signal", message="VIP Indicator: SELL Signal on {{ticker}} at {{close}}")
